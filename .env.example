# AgenticFlow AI - Environment Variables Template
# Copy this file to .env and fill in your API credentials.

# OpenAI API Key (For GPT-4o, GPT-4o-mini models)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Anthropic API Key (For Claude 3.5 Sonnet / Claude models)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Tavily API Key (For real-time web search capabilities)
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# LangSmith Observability & Tracing (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-api-key-here
LANGCHAIN_PROJECT=agenticflow-ai
